# Kopyahin bilang .env sa server. HUWAG i-commit. HUWAG i-paste sa chat.
# Iwasan ang espasyo, quotes at $ sa mga password (binabasa din ito ng backup script).

# --- Site ---
# Habang IP lang: :80    Kapag may domain: practicum.iyongdomain.com
SITE_ADDRESS=:80

# --- MySQL (nasa loob ng Docker) ---
MYSQL_ROOT_PASSWORD=palitan-ng-mahabang-random
MYSQL_DATABASE=practicum
MYSQL_USER=practicum
MYSQL_PASSWORD=palitan-ng-mahabang-random
# update muna para hindi mag-crash sa pagkakaiba ng schema; pwedeng gawing validate kapag stable na
DDL_AUTO=update

# --- AWS S3 (IAM user na limitado sa bucket lang; tingnan ang DEPLOY.md) ---
APP_S3_BUCKET=practicum-uploads-bucket
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- JWT ---
# openssl rand -base64 48
JWT_SECRET=

# --- Backup script ---
BACKUP_S3_PREFIX=db-backups

# --- Memory (default ay para sa 1 GB na server) ---
# Para sa 2 GB na plan, alisin ang # sa ibaba:
#JAVA_OPTS=-Xms256m -Xmx768m
#MYSQL_BUFFER_POOL=384M
#MYSQL_MAX_CONNECTIONS=80
